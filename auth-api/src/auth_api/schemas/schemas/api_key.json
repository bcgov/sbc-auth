{
    "definitions": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://bcrs.gov.bc.ca/.well_known/schemas/api_key",
    "type": "object",
    "title": "API Key",
    "additionalProperties": false,
    "anyOf": [
      {"required": ["apiKeyName"]},
      {"required": ["keyName"], "$comment": "keyName is deprecated, accepted for existing callers"}
    ],
    "properties": {
      "apiKeyName": {
        "$id": "#/properties/apiKeyName",
        "type": "string",
        "title": "Name of the key",
        "default": "",
        "examples": [
          "UAT API Key"
        ],
        "pattern": "^[^\\s]+(\\s+[^\\s]+)*$"
      },
      "keyName": {
        "$id": "#/properties/keyName",
        "type": "string",
        "title": "Name of the key (deprecated, use apiKeyName)",
        "default": "",
        "examples": [
          "prod-1-key-main"
        ],
        "pattern": "^[^\\s]+(\\s+[^\\s]+)*$"
      }
    }
  }
